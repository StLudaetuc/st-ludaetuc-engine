{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DRAFT independently supplied expected anchor; NOT producer approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expected_manifest_hash",
    "expected_audit_sha256",
    "source_count",
    "exported_count",
    "scope",
    "window",
    "acquired_at",
    "operator_identity_reference",
    "manifest_version",
    "redaction_version",
    "records",
    "custody_reference"
  ],
  "properties": {
    "expected_manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_audit_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_count": {
      "type": "integer",
      "minimum": 0
    },
    "exported_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50000
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument",
        "timeframe",
        "environment"
      ],
      "properties": {
        "instrument": {
          "enum": [
            "GBPUSD",
            "EURUSD",
            "AUDUSD",
            "USDCAD",
            "USDJPY",
            "XAUUSD",
            "XAGUSD"
          ]
        },
        "timeframe": {
          "enum": [
            "1m",
            "2m",
            "3m",
            "5m",
            "10m"
          ]
        },
        "environment": {
          "enum": [
            "production",
            "shadow",
            "development",
            "test"
          ]
        }
      }
    },
    "window": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "maxLength": 40
        },
        "end": {
          "type": "string",
          "maxLength": 40
        }
      }
    },
    "acquired_at": {
      "type": "string",
      "maxLength": 40
    },
    "operator_identity_reference": {
      "type": "string",
      "maxLength": 160
    },
    "manifest_version": {
      "const": "historical_acquisition_v1.1"
    },
    "redaction_version": {
      "const": "structured_secret_redaction_v2"
    },
    "records": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "custody_reference": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:/-]{1,160}$"
    }
  }
}