{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stludaetuc:draft:historical-quality-v1",
  "title": "DRAFT historical dataset quality summary (no raw records)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "observed_total", "raw_records_validated", "timestamp_validity", "population_completeness", "streams", "postgres_runtime"],
  "properties": {
    "schema_version": {"const": "historical_population_summary_v1"},
    "source": {"type": "string", "maxLength": 512},
    "observed_total": {"type": ["integer", "null"], "minimum": 0},
    "reported_iso_time": {"type": ["integer", "null"], "minimum": 0},
    "reported_epoch_ms_time_open": {"type": ["integer", "null"], "minimum": 0},
    "reported_missing_both": {"type": ["integer", "null"], "minimum": 0},
    "raw_records_validated": {"type": "integer", "minimum": 0},
    "timestamp_validity": {"enum": ["UNPROVED", "PARTIALLY_VALIDATED", "VALIDATED_CAPTURED_POPULATION"]},
    "population_completeness": {"enum": ["UNPROVED", "COMPLETE_CAPTURED_SNAPSHOT_ONLY"]},
    "postgres_runtime": {"enum": ["UNPROVED", "PASSED_LOCAL_DISPOSABLE_18"]},
    "streams": {
      "type": "array", "minItems": 1, "maxItems": 35,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["instrument", "timeframe", "reported_source_field_presence", "raw_validated", "invalid_timestamp_count", "missing_expected_intervals", "recovery_state", "research_readiness"],
        "properties": {
          "instrument": {"enum": ["GBPUSD", "EURUSD", "AUDUSD", "USDCAD", "USDJPY", "XAUUSD", "XAGUSD"]},
          "timeframe": {"enum": ["1m", "2m", "3m", "5m", "10m"]},
          "reported_source_field_presence": {"const": true},
          "raw_validated": {"const": 0},
          "invalid_timestamp_count": {"type": "null"},
          "missing_expected_intervals": {"type": "null"},
          "recovery_state": {"enum": ["NOT_YET_ASSESSED"]},
          "research_readiness": {"const": "BLOCKED_ON_ROW_LEVEL_EVIDENCE"}
        }
      }
    }
  }
}
