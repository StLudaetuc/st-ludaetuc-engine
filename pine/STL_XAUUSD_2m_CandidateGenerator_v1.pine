    if longArmed
        longArmedText := "ARMED, low<" + str.tostring(longArmedReferenceLow, format.mintick)
    else if longAwaitingReversal
        longArmedText := "REVERSAL WAIT, close>" + str.tostring(longReversalTriggerHigh, format.mintick)

