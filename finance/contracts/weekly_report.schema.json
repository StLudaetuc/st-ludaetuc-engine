{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:st-ludaetuc:finance:weekly:v2",
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "currency",
        "state",
        "reason",
        "evidence_id",
        "classification"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?[0-9]{1,36}(\\.[0-9]{1,12})?$",
          "maxLength": 50
        },
        "currency": {
          "const": "GBP"
        },
        "state": {
          "enum": [
            "verified",
            "observed_incomplete",
            "estimate",
            "unavailable",
            "hypothetical"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "evidence_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "classification": {
          "enum": [
            "FACT",
            "ESTIMATED",
            "UNKNOWN",
            "HYPOTHETICAL"
          ]
        }
      }
    },
    "drawdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "state",
        "reason",
        "evidence_id",
        "classification"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0(\\.[0-9]{1,12})?|1(\\.0{1,12})?)$",
          "maxLength": 14
        },
        "unit": {
          "const": "fraction_of_capital"
        },
        "state": {
          "enum": [
            "approved_assumption",
            "observed_incomplete",
            "unavailable"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "evidence_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "classification": {
          "enum": [
            "ESTIMATED",
            "UNKNOWN"
          ]
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of",
    "period_start",
    "period_end",
    "account_alias",
    "broker_environment",
    "system_environment",
    "financial_reality",
    "financial_state",
    "coverage_complete",
    "trade_count",
    "exception_count",
    "pending_eod_count",
    "source_manifest_id",
    "formula_version",
    "lifetime",
    "this_week",
    "run_rate",
    "unit_economics",
    "forecast_inputs",
    "assumption_set_id",
    "allocation_policy",
    "simulation_type",
    "scope_level",
    "classification",
    "basis",
    "coverage_state",
    "evidence_count",
    "first_evidence_id",
    "last_evidence_id",
    "unresolved_exception_count",
    "reconciliation_state",
    "denominator_basis",
    "money_policy",
    "currency_confirmed",
    "costs_complete",
    "recognition_policy",
    "recognition_policy_missing_count"
  ],
  "properties": {
    "schema_version": {
      "const": "finance_weekly_v2"
    },
    "as_of": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "period_start": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "period_end": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "account_alias": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "broker_environment": {
      "enum": [
        "OANDA_PRACTICE",
        "OANDA_LIVE"
      ]
    },
    "system_environment": {
      "enum": [
        "DEVELOPMENT",
        "VALIDATION",
        "DEMO",
        "SHADOW",
        "REPLAY",
        "PRODUCTION"
      ]
    },
    "financial_reality": {
      "enum": [
        "ACTUAL",
        "SIMULATED"
      ]
    },
    "financial_state": {
      "const": "REALISED"
    },
    "coverage_complete": {
      "type": "boolean"
    },
    "trade_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000000000
    },
    "exception_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "pending_eod_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "source_manifest_id": {
      "type": "string",
      "maxLength": 128
    },
    "formula_version": {
      "const": "finance_foundation_v2"
    },
    "lifetime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_spent",
        "gross_trading_pnl",
        "financing",
        "other_trading_costs",
        "net_economic_pnl",
        "remaining_break_even",
        "cash_spend",
        "economic_expense"
      ],
      "properties": {
        "total_spent": {
          "$ref": "#/$defs/metric"
        },
        "gross_trading_pnl": {
          "$ref": "#/$defs/metric"
        },
        "financing": {
          "$ref": "#/$defs/metric"
        },
        "other_trading_costs": {
          "$ref": "#/$defs/metric"
        },
        "net_economic_pnl": {
          "$ref": "#/$defs/metric"
        },
        "remaining_break_even": {
          "$ref": "#/$defs/metric"
        },
        "cash_spend": {
          "$ref": "#/$defs/metric"
        },
        "economic_expense": {
          "$ref": "#/$defs/metric"
        }
      }
    },
    "this_week": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "infrastructure",
        "api_ai",
        "subscriptions",
        "rd_testing",
        "other_operating_costs",
        "broker_costs",
        "realised_pnl",
        "net_result",
        "cash_spend",
        "economic_expense"
      ],
      "properties": {
        "infrastructure": {
          "$ref": "#/$defs/metric"
        },
        "api_ai": {
          "$ref": "#/$defs/metric"
        },
        "subscriptions": {
          "$ref": "#/$defs/metric"
        },
        "rd_testing": {
          "$ref": "#/$defs/metric"
        },
        "other_operating_costs": {
          "$ref": "#/$defs/metric"
        },
        "broker_costs": {
          "$ref": "#/$defs/metric"
        },
        "realised_pnl": {
          "$ref": "#/$defs/metric"
        },
        "net_result": {
          "$ref": "#/$defs/metric"
        },
        "cash_spend": {
          "$ref": "#/$defs/metric"
        },
        "economic_expense": {
          "$ref": "#/$defs/metric"
        }
      }
    },
    "run_rate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cost_per_day",
        "cost_per_month",
        "cost_per_year"
      ],
      "properties": {
        "cost_per_day": {
          "$ref": "#/$defs/metric"
        },
        "cost_per_month": {
          "$ref": "#/$defs/metric"
        },
        "cost_per_year": {
          "$ref": "#/$defs/metric"
        }
      }
    },
    "unit_economics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cost_per_trade",
        "gross_profit_per_trade",
        "financing_per_trade",
        "net_profit_per_trade",
        "realised_expectancy"
      ],
      "properties": {
        "cost_per_trade": {
          "$ref": "#/$defs/metric"
        },
        "gross_profit_per_trade": {
          "$ref": "#/$defs/metric"
        },
        "financing_per_trade": {
          "$ref": "#/$defs/metric"
        },
        "net_profit_per_trade": {
          "$ref": "#/$defs/metric"
        },
        "realised_expectancy": {
          "$ref": "#/$defs/metric"
        }
      }
    },
    "forecast_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capital",
        "realised_expectancy",
        "operating_costs",
        "financing_assumption",
        "drawdown_assumption"
      ],
      "properties": {
        "capital": {
          "$ref": "#/$defs/metric"
        },
        "realised_expectancy": {
          "$ref": "#/$defs/metric"
        },
        "operating_costs": {
          "$ref": "#/$defs/metric"
        },
        "financing_assumption": {
          "$ref": "#/$defs/metric"
        },
        "drawdown_assumption": {
          "$ref": "#/$defs/drawdown"
        }
      }
    },
    "assumption_set_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "allocation_policy": {
      "const": "period_operating_cost_divided_by_unique_fully_closed_reconciled_trades"
    },
    "simulation_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "COUNTERFACTUAL",
        "SHADOW",
        "REPLAY",
        "VALIDATION"
      ]
    },
    "scope_level": {
      "enum": [
        "PROJECT",
        "ACCOUNT"
      ]
    },
    "classification": {
      "enum": [
        "FACT",
        "MIXED",
        "ESTIMATED",
        "UNKNOWN",
        "HYPOTHETICAL"
      ]
    },
    "basis": {
      "enum": [
        "ACTUAL_CASH",
        "HYPOTHETICAL_NON_CASH"
      ]
    },
    "coverage_state": {
      "enum": [
        "VERIFIED",
        "REVIEWED_EMPTY",
        "UNKNOWN",
        "INCOMPLETE",
        "WITHDRAWN"
      ]
    },
    "evidence_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "first_evidence_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "last_evidence_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "unresolved_exception_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "reconciliation_state": {
      "enum": [
        "MATCHED",
        "BROKER_ONLY",
        "INTERNAL_ONLY",
        "VALUE_MISMATCH",
        "PENDING_EOD_SYNC",
        "INVESTIGATION_REQUIRED"
      ]
    },
    "denominator_basis": {
      "enum": [
        "attempted_orders",
        "filled_orders",
        "closed_trades",
        "partial_close_slices",
        "transactions"
      ]
    },
    "money_policy": {
      "const": "money_scale12_half_away_v1"
    },
    "currency_confirmed": {
      "type": "boolean"
    },
    "costs_complete": {
      "type": "boolean"
    },
    "recognition_policy": {
      "const": "EXPLICIT_PER_EXPENSE"
    },
    "recognition_policy_missing_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    }
  }
}
