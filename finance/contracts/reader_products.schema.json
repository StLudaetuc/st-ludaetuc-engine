  "$id": "urn:st-ludaetuc:finance:reader:v2",
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "currency",
        "state",
        "reason",
        "evidence_id",
        "classification"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?[0-9]{1,36}(\\.[0-9]{1,12})?$",
          "maxLength": 50
        },
        "currency": {
          "const": "GBP"
        },
        "state": {
          "enum": [
            "verified",
            "observed_incomplete",
            "estimate",
            "unavailable",
            "hypothetical"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "evidence_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "classification": {
          "enum": [
            "FACT",
            "ESTIMATED",
            "UNKNOWN",
            "HYPOTHETICAL"
          ]
        }
      }
    },
    "drawdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "state",
        "reason",
        "evidence_id",
        "classification"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0(\\.[0-9]{1,12})?|1(\\.0{1,12})?)$",
          "maxLength": 14
        },
        "unit": {
          "const": "fraction_of_capital"
        },
        "state": {
          "enum": [
            "approved_assumption",
            "observed_incomplete",
            "unavailable"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "evidence_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "classification": {
          "enum": [
            "ESTIMATED",
            "UNKNOWN"
          ]
        }
      }
    }
  },
